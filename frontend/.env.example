# Create a Formspree form with your Gmail address as the notification recipient.
# Optional override for contact.formId in src/data/portfolio.ts.
# Paste only the form ID: https://formspree.io/f/abcdefgh -> abcdefgh
# AJAX sending requires Formspree's hosted reCAPTCHA to be disabled.
# An in-page CAPTCHA integration is needed if you want to keep CAPTCHA enabled.
# This ID is public and will appear in the built JavaScript.
# Never put Gmail passwords, SMTP credentials, or secret API keys in a VITE_ variable.
VITE_FORMSPREE_FORM_ID=xaeqealw
